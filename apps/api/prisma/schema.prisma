// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Category {
  id               Int     @id @default(autoincrement())
  categoryName     String
  categoryCode     String  @unique
  parentCategoryId Int?
  categoryImage    String?
  categoryColor    String?
  categorySort     Int
  categoryStatus   Boolean

  parentCategory Category?  @relation("ParentCategory", fields: [parentCategoryId], references: [id])
  subCategories  Category[] @relation("ParentCategory")
  products       Product[]  @relation("ProductCategory")
  taxes          Tax[]      @relation("CategoryTaxes")
  coupons        Coupon[]   @relation("CategoryCoupons")

  @@index([categoryCode])
  @@index([parentCategoryId])
}

model Brand {
  id          Int       @id @default(autoincrement())
  brandName   String
  brandCode   String    @unique
  brandImage  String?
  brandStatus Boolean
  products    Product[] @relation("ProductBrand")

  @@index([brandCode])
}

model Unit {
  id            Int       @id @default(autoincrement())
  unitName      String
  unitShortName String
  unitStatus    Boolean
  products      Product[] @relation("ProductUnit")
}

model ProductVariantOption {
  id                 Int                              @id @default(autoincrement())
  optionName         String
  optionStatus       Boolean
  optionValues       ProductVariantOptionValue[]      @relation("VariantOptionValues")
  variantAssignments ProductVariantOptionAssignment[] @relation("VariantOptionAssignments")
}

model ProductVariantOptionValue {
  id                 Int                              @id @default(autoincrement())
  optionValueName    String
  optionValueStatus  Boolean
  variantOptionId    Int
  variantOption      ProductVariantOption             @relation("VariantOptionValues", fields: [variantOptionId], references: [id])
  variantAssignments ProductVariantOptionAssignment[] @relation("VariantOptionValueAssignments")
}

model ProductVariantOptionAssignment {
  id                   Int                       @id @default(autoincrement())
  productVariantId     Int
  variantOptionId      Int
  variantOptionValueId Int
  productVariant       ProductVariant            @relation("VariantAssignments", fields: [productVariantId], references: [id])
  variantOption        ProductVariantOption      @relation("VariantOptionAssignments", fields: [variantOptionId], references: [id])
  variantOptionValue   ProductVariantOptionValue @relation("VariantOptionValueAssignments", fields: [variantOptionValueId], references: [id])
}

model Product {
  id                 Int            @id @default(autoincrement())
  productName        String
  productSKU         String         @unique
  minQuantity        Int
  stockAlert         Int
  quantity           Int
  price              Float
  productStatus      Boolean
  discountType       EDiscountType?
  discountedValue    Float?
  expireDate         DateTime?
  isAddonProduct     Boolean
  productDescription String?
  thumbnail          String?
  productType        EProductType
  categoryId         Int
  brandId            Int?
  salesUnitId        Int
  taxId              Int?

  category       Category         @relation("ProductCategory", fields: [categoryId], references: [id])
  brand          Brand?           @relation("ProductBrand", fields: [brandId], references: [id])
  salesUnit      Unit             @relation("ProductUnit", fields: [salesUnitId], references: [id])
  tax            Tax?             @relation("ProductTax", fields: [taxId], references: [id])
  variants       ProductVariant[] @relation("ProductVariants")
  purchases      Purchase[]       @relation("ProductPurchases")
  sales          Sales[]          @relation("ProductSales")
  groupProducts  GroupProduct[]   @relation("GroupProductComponents")
  groupedBy      GroupProduct[]   @relation("GroupedProduct")
  coupons        Coupon[]         @relation("ProductCoupons")
  binInventories BinInventory[]   @relation("BinInventoryProduct")
  orderItems     OrderItem[]      @relation("OrderItemProduct")

  stockTransfers StockTransfer[] @relation("ProductStockTransfers")

  @@index([categoryId])
  @@index([brandId])
  @@index([salesUnitId])
  @@index([taxId])
}

model ProductVariant {
  id                     Int            @id @default(autoincrement())
  variantName            String
  variantQuantity        Int
  variantPrice           Float
  variantDiscountType    EDiscountType?
  variantDiscountedValue Float?
  productId              Int

  product            Product                          @relation("ProductVariants", fields: [productId], references: [id])
  variantAssignments ProductVariantOptionAssignment[] @relation("VariantAssignments")
  groupProducts      GroupProduct[]                   @relation("GroupProductVariant")
  binInventories     BinInventory[]                   @relation("BinInventoryVariant")
  orderItems         OrderItem[]                      @relation("OrderItemVariant")
  stockTransfers     StockTransfer[]                  @relation("StockTransferVariant")
}

model GroupProduct {
  id               Int  @id @default(autoincrement())
  groupProductId   Int
  productId        Int
  productQuantity  Int
  productVariantId Int?

  groupProduct   Product         @relation("GroupedProduct", fields: [groupProductId], references: [id])
  product        Product         @relation("GroupProductComponents", fields: [productId], references: [id])
  productVariant ProductVariant? @relation("GroupProductVariant", fields: [productVariantId], references: [id])
}

model Purchase {
  id          Int   @id @default(autoincrement())
  quantity    Int
  price       Float
  productId   Int
  warehouseId Int?
  supplierId  Int?

  supplier  Supplier?  @relation(fields: [supplierId], references: [id])
  product   Product    @relation("ProductPurchases", fields: [productId], references: [id])
  warehouse Warehouse? @relation("PurchaseWarehouse", fields: [warehouseId], references: [id])
}

model Supplier {
  id        Int        @id @default(autoincrement())
  name      String
  email     String?
  phone     String?
  address   String?
  isActive  Boolean    @default(true)
  purchases Purchase[]
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
}

model Sales {
  id          Int    @id @default(autoincrement())
  quantity    Int
  unitPrice   Float
  totalPrice  Float?
  productId   Int
  taxId       Int?
  couponId    Int?
  warehouseId Int?
  customerId  Int?

  product   Product    @relation("ProductSales", fields: [productId], references: [id])
  tax       Tax?       @relation("SalesTax", fields: [taxId], references: [id])
  coupon    Coupon?    @relation("SalesCoupon", fields: [couponId], references: [id])
  warehouse Warehouse? @relation("SalesWarehouse", fields: [warehouseId], references: [id])
  customer  Customer?  @relation("CustomerSales", fields: [customerId], references: [id])
}

model Tax {
  id         Int        @id @default(autoincrement())
  taxName    String
  taxCode    String     @unique
  taxRate    Float
  isActive   Boolean
  products   Product[]  @relation("ProductTax")
  sales      Sales[]    @relation("SalesTax")
  categories Category[] @relation("CategoryTaxes")
}

model Coupon {
  id            Int           @id @default(autoincrement())
  couponCode    String        @unique
  discountType  EDiscountType
  discountValue Float
  validFrom     DateTime?
  validUntil    DateTime?
  usageLimit    Int?
  usedCount     Int           @default(0)
  isActive      Boolean
  products      Product[]     @relation("ProductCoupons")
  sales         Sales[]       @relation("SalesCoupon")
  categories    Category[]    @relation("CategoryCoupons")
}

model Branch {
  id         Int         @id @default(autoincrement())
  branchName String
  branchCode String      @unique
  address    String?
  isActive   Boolean
  warehouses Warehouse[] @relation("BranchWarehouses")
  orders     Order[]     @relation("BranchOrders")
}

model Warehouse {
  id                 Int             @id @default(autoincrement())
  warehouseName      String
  warehouseCode      String          @unique
  branchId           Int
  isActive           Boolean
  branch             Branch          @relation("BranchWarehouses", fields: [branchId], references: [id])
  bins               Bin[]           @relation("WarehouseBins")
  purchases          Purchase[]      @relation("PurchaseWarehouse")
  sales              Sales[]         @relation("SalesWarehouse")
  binInventories     BinInventory[]  @relation("WarehouseBinInventories")
  stockTransfersFrom StockTransfer[] @relation("StockTransferFromWarehouse")
  stockTransfersTo   StockTransfer[] @relation("StockTransferToWarehouse")
}

model Bin {
  id             Int            @id @default(autoincrement())
  binCode        String         @unique
  warehouseId    Int
  description    String?
  isActive       Boolean
  warehouse      Warehouse      @relation("WarehouseBins", fields: [warehouseId], references: [id])
  binInventories BinInventory[] @relation("BinInventories")
}

model BinInventory {
  id               Int  @id @default(autoincrement())
  warehouseId      Int
  binId            Int
  productId        Int
  productVariantId Int?
  quantity         Int

  warehouse      Warehouse       @relation("WarehouseBinInventories", fields: [warehouseId], references: [id])
  bin            Bin             @relation("BinInventories", fields: [binId], references: [id])
  product        Product         @relation("BinInventoryProduct", fields: [productId], references: [id])
  productVariant ProductVariant? @relation("BinInventoryVariant", fields: [productVariantId], references: [id])
}

model Customer {
  id            Int      @id @default(autoincrement())
  customerName  String
  email         String?  @unique
  phone         String?
  loyaltyPoints Int      @default(0)
  isActive      Boolean
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  orders        Order[]  @relation("CustomerOrders")
  sales         Sales[]  @relation("CustomerSales")
}

model Order {
  id          Int         @id @default(autoincrement())
  orderNumber String      @unique
  customerId  Int?
  branchId    Int?
  totalAmount Float
  taxId       Int?
  couponId    Int?
  status      OrderStatus
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  customer Customer? @relation("CustomerOrders", fields: [customerId], references: [id])
  branch   Branch?   @relation("BranchOrders", fields: [branchId], references: [id])

  orderItems OrderItem[] @relation("OrderItems")
  payments   Payment[]   @relation("OrderPayments")
  Return     Return?
}

model OrderItem {
  id               Int   @id @default(autoincrement())
  orderId          Int
  productId        Int
  productVariantId Int?
  quantity         Int
  unitPrice        Float

  order          Order           @relation("OrderItems", fields: [orderId], references: [id])
  product        Product         @relation("OrderItemProduct", fields: [productId], references: [id])
  productVariant ProductVariant? @relation("OrderItemVariant", fields: [productVariantId], references: [id])
}

model Payment {
  id            Int           @id @default(autoincrement())
  orderId       Int
  amount        Float
  paymentMethod String
  paymentStatus PaymentStatus
  transactionId String?       @unique
  createdAt     DateTime      @default(now())

  order Order @relation("OrderPayments", fields: [orderId], references: [id])
}

model StockTransfer {
  id               Int            @id @default(autoincrement())
  transferNumber   String         @unique
  fromWarehouseId  Int
  toWarehouseId    Int
  productId        Int
  productVariantId Int?
  quantity         Int
  status           TransferStatus
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  fromWarehouse  Warehouse       @relation("StockTransferFromWarehouse", fields: [fromWarehouseId], references: [id])
  toWarehouse    Warehouse       @relation("StockTransferToWarehouse", fields: [toWarehouseId], references: [id])
  product        Product         @relation("ProductStockTransfers", fields: [productId], references: [id])
  productVariant ProductVariant? @relation("StockTransferVariant", fields: [productVariantId], references: [id])
}

model Return {
  id          Int      @id @default(autoincrement())
  orderId     Int      @unique
  reason      String?
  totalRefund Float
  processed   Boolean  @default(false)
  createdAt   DateTime @default(now())
  order       Order    @relation(fields: [orderId], references: [id])
}

model User {
  id        Int      @id @default(autoincrement())
  name      String
  email     String   @unique
  password  String
  role      UserRole
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum UserRole {
  admin
  manager
  cashier
  viewer
}

enum EDiscountType {
  flat
  percentage
}

enum EProductType {
  single
  group
  variation
}

enum OrderStatus {
  pending
  completed
  cancelled
  returned
}

enum PaymentStatus {
  pending
  completed
  failed
  refunded
}

enum TransferStatus {
  pending
  completed
  cancelled
}
